extends SceneTree
const PATH: String = "res://.godot/validation/test_progress.json"

func _initialize() -> void:
	call_deferred("run")

func run() -> void:
	assert(ScoreRules.grade(1500, 1, 1) == 3)
	assert(ScoreRules.grade(1501, 1, 1) == 2)
	assert(ScoreRules.grade(1000, 2, 1) == 1)
	assert(ScoreRules.grade(0, 0, 1) == 0)
	var profile := ProgressStore.new(PATH)
	assert(profile.save_to_disk())
	assert(profile.is_unlocked("M1") and not profile.is_unlocked("M2"))
	assert(profile.record_result("M1", 1500, 1, 1))
	assert(profile.is_unlocked("M2") and not profile.is_unlocked("M3"))
	assert(profile.record_result("M1", 1000, 2, 1))
	assert(profile.result_for("M1")["stars"] == 3 and profile.result_for("M1")["best_ticks"] == 1000)
	profile.set_setting("master_volume", 0.25)
	profile.set_setting("reduce_flashes", true)
	profile.set_setting("screen_shake", false)
	assert(profile.save_to_disk())
	var reloaded := ProgressStore.new(PATH)
	assert(reloaded.load_from_disk())
	assert(reloaded.result_for("M1")["stars"] == 3 and reloaded.is_unlocked("M2"))
	assert(reloaded.settings["master_volume"] == 0.25 and reloaded.settings["reduce_flashes"] and not reloaded.settings["screen_shake"])
	var file := FileAccess.open(PATH, FileAccess.WRITE)
	file.store_string("{broken json")
	file.close()
	var damaged := ProgressStore.new(PATH)
	assert(not damaged.load_from_disk() and damaged.mission_results.is_empty() and not damaged.last_error.is_empty())
	assert(damaged.record_result("M1", 1100, 1, 1))
	assert(FileAccess.get_file_as_string(PATH).contains("version"))
	var files := DirAccess.get_files_at("res://.godot/validation")
	var backed_up: bool = false
	for name: String in files:
		backed_up = backed_up or name.begins_with("test_progress.json.corrupt-")
	assert(backed_up, "Damaged data must be preserved before replacement")
	file = FileAccess.open(PATH, FileAccess.WRITE)
	file.store_string(JSON.stringify({"version": 999, "missions": {}}))
	file.close()
	var future := ProgressStore.new(PATH)
	assert(not future.load_from_disk())
	assert(not future.record_result("M1", 1000, 1, 1))
	assert(FileAccess.get_file_as_string(PATH).contains("999"), "Never overwrite a newer schema")
	var transient := ProgressStore.new("")
	transient.set_setting("sfx_volume", 9)
	transient.set_setting("show_hints", "invalid")
	assert(transient.settings["sfx_volume"] == 1.0 and transient.settings["show_hints"] == true)
	var app: Control = CampaignFixture.app(false)
	root.add_child(app)
	app.show_screen("mission:M2")
	assert(app.current_route == "select", "Locked mission route is enforced, not just a disabled button")
	app.progress.record_result("M1", 1300, 1, 1)
	app.show_screen("mission:M2")
	assert(app.current_route == "mission" and app.screen.definition.mission_id == "M2")
	var mission: Control = app.screen
	mission.set_physics_process(false)
	mission.apply_preferences({"show_hints": true, "reduce_flashes": true, "screen_shake": false})
	assert(mission.world.rook.reduce_flashes and not mission.world.camera.shake_enabled)
	mission.request_hint()
	assert(mission.paused and mission.hint_level == 1)
	mission.close_hint()
	mission.request_hint()
	assert(mission.hint_level == 2 and mission.world.highlight_active)
	mission.close_hint()
	mission.request_hint()
	assert(mission.hint_level == 3)
	mission.close_hint()
	mission.apply_preferences({"show_hints": false})
	mission.request_hint()
	assert(not mission.paused)
	app.queue_free()
	await process_frame
	print("PASS progress: score boundaries, ordered unlocks/route guard, atomic save/overwrite/reload, settings, corrupt backup/future protection, isolated profile, progressive hints/preferences")
	quit(0)
